# PC Agent V0.2 — copy to .env on Windows PC

ALPILAB_WS_URL=ws://127.0.0.1:8000
ALPILAB_SESSION_ID=repair-001
ALPILAB_AGENT_NAME=ALPILAB-PC
ALPILAB_AGENT_PLATFORM=windows
ALPILAB_AGENT_VERSION=0.2.0
ALPILAB_HEARTBEAT_INTERVAL=25
ALPILAB_RECONNECT_BASE_DELAY=1
ALPILAB_RECONNECT_MAX_DELAY=32
ALPILAB_RECONNECT_MAX_ATTEMPTS=8
ALPILAB_LOG_LEVEL=INFO

# Declarative capabilities (NOT execution permission)
ALPILAB_CAP_SAFE_TEST=true
ALPILAB_CAP_WINDOWS_APPS=false
ALPILAB_CAP_ALPILAB_CHECK=false
ALPILAB_CAP_THERMAL_CAMERA=false
ALPILAB_CAP_MULTIMETER=false
ALPILAB_CAP_POWER_SUPPLY=false
