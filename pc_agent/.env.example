# PC Agent V0.3 — copy to .env on Windows PC

ALPILAB_WS_URL=ws://127.0.0.1:8000
ALPILAB_SESSION_ID=repair-001
ALPILAB_AGENT_NAME=ALPILAB-PC
ALPILAB_AGENT_PLATFORM=windows
ALPILAB_AGENT_VERSION=0.3.0
ALPILAB_HEARTBEAT_INTERVAL=25
ALPILAB_RECONNECT_BASE_DELAY=1
ALPILAB_RECONNECT_MAX_DELAY=32
ALPILAB_RECONNECT_MAX_ATTEMPTS=8
ALPILAB_LOG_LEVEL=INFO

# Capabilities (declarative — execution still requires local app registration)
ALPILAB_CAP_SAFE_TEST=true
ALPILAB_CAP_WINDOWS_APPS=true
ALPILAB_CAP_ALPILAB_CHECK=false
ALPILAB_CAP_THERMAL_CAMERA=false
ALPILAB_CAP_MULTIMETER=false
ALPILAB_CAP_POWER_SUPPLY=false

# 3uTools — local trusted configuration (path is NEVER sent from server)
ALPILAB_WINAPP_3UTOOLS_ENABLED=true
ALPILAB_WINAPP_3UTOOLS_PATH=C:\Program Files\3uTools\3uTools.exe
ALPILAB_WINAPP_3UTOOLS_DRY_RUN=true

# Optional JSON config: %USERPROFILE%\.alpilab\windows_apps.json
# ALPILAB_WINDOWS_APPS_CONFIG=C:\Users\you\.alpilab\windows_apps.json
