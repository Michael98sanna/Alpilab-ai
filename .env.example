# Alpilab AI environment configuration
# Copy to .env and adjust locally. Never commit real secrets.

# Active AI provider identifier (mock for development)
AI_PROVIDER=mock

# Debug mode
DEBUG=false

# Future: database URL (PostgreSQL in production, SQLite for local dev)
# DATABASE_URL=sqlite:///runtime_data/alpilab_ai.db

# Future: object storage for images and documents
# STORAGE_BACKEND=local
# STORAGE_PATH=runtime_data/storage

# Future provider credentials (examples only — do not put real keys here)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Future Alpilab Check bridge endpoint
# ALPILAB_CHECK_BRIDGE_URL=

# Future Alpilab Hub endpoint on the Windows workstation
# ALPILAB_HUB_URL=
