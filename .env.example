# Alpilab AI — environment template
# Copy to `.env` and fill in local values.
# NEVER put real API keys or passwords in the repository.

# Runtime
APP_NAME=Alpilab AI
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# CORS: comma-separated origins for web/mobile clients.
# Use * only in local development.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI routing — phase 1 supports only "mock".
# Future values may include local/cloud provider names.
AI_PROVIDER=mock

# Future cloud providers (leave empty until a provider is actually wired).
# Do not commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Future database (not used in this phase).
# Production target: PostgreSQL. SQLite may be used for local development.
DATABASE_URL=
