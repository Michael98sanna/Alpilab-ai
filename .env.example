# Application
APP_NAME=Alpilab AI
APP_ENV=development

# AI provider: only "mock" is implemented in this phase.
# Future values (not wired): openai, anthropic, google, local, ...
AI_PROVIDER=mock

# Database — placeholder. No live DB required yet.
# Production target: PostgreSQL. Local optional: SQLite.
DATABASE_URL=sqlite:///./runtime_data/alpilab_ai.db

# Local file storage root for future photos/docs
STORAGE_ROOT=./runtime_data/storage

# Hub safety — keep dangerous actions disabled until Hub is real.
ALLOW_DANGEROUS_HUB_ACTIONS=false
REQUIRE_CONFIRMATION_FOR_DANGEROUS_ACTIONS=true

# --- Future secrets (NEVER commit real values) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
