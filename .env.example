# Alpilab AI — file di configurazione locale (NON committare)
# Copia questo file in `.env` e inserisci i valori reali.
# In dev: metti `.env` nella root del progetto Alpilab-ai.
# Con la EXE: metti `.env` nella stessa cartella di `ALPILAB AI.exe`
# (es. Alpilab-ai\build\release\.env).

# --- Database (opzionale) ---
# Percorso SQLite usato dal Local Hub. Default: %USERPROFILE%\.alpilab\data\alpilab.db
# ALPILAB_DATABASE_URL=sqlite:///%USERPROFILE%/.alpilab/data/alpilab.db

# --- ALPILAB Brain: provider cloud (opzionali, almeno uno consigliato) ---
# OpenAI — abilita GPT-4o mini per diagnosi e chat. Richiede credito API separato
# (ChatGPT Plus non include le API). Prefisso atteso: sk-
# OPENAI_API_KEY=

# Anthropic — abilita Claude per ragionamento diagnostico. Prefisso atteso: sk-ant-
# ANTHROPIC_API_KEY=

# Google Gemini — risposte rapide/spiegazioni. Prefisso atteso: AIza
# GOOGLE_API_KEY=

# Perplexity — ricerca knowledge. Prefisso atteso: pplx-
# PERPLEXITY_API_KEY=

# --- Ollama locale (fallback gratuito) ---
# URL del servizio Ollama sul PC. Default: http://127.0.0.1:11434
# Dopo l'installazione esegui: ollama pull llama3.2
# ALPILAB_OLLAMA_URL=http://127.0.0.1:11434

# --- Percorsi avanzati (opzionali) ---
# File .env alternativo (priorità massima se impostato)
# ALPILAB_ENV_FILE=C:\percorso\custom\.env
# Config provider LLM YAML alternativa
# ALPILAB_LLM_CONFIG=config/llm_providers.yaml

# --- Hub / sessione (di solito impostati automaticamente dal launcher EXE) ---
# ALPILAB_DEFAULT_SESSION=repair-001
# PORT=8000

# --- Legacy / altri moduli ---
# AI_PROVIDER=mock
# DEBUG=false
# CORS_ORIGINS=http://192.168.1.10:5173
