# Alpilab AI - environment template
# Copy to .env and fill values locally. Never commit .env or real secrets.

# Application
APP_NAME=Alpilab AI
APP_ENV=development
DEBUG=true

# AI routing (mock | local | cloud — only mock is implemented in this phase)
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock

# Future cloud providers — leave empty until real integration
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Database (not wired yet; placeholders for future work)
# DATABASE_URL=postgresql://user:pass@localhost:5432/alpilab_ai
# SQLITE_PATH=./runtime_data/alpilab_ai.db

# Storage (not wired yet)
# STORAGE_PATH=./runtime_data/storage
