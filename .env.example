# Application
APP_NAME=Alpilab AI
APP_ENV=development
APP_DEBUG=true

# HTTP API
API_HOST=0.0.0.0
API_PORT=8000

# AI provider selection (phase 1: mock only)
# Future values may include: mock | local | openai | anthropic | google
AI_PROVIDER=mock

# Database (not wired yet — placeholder for future persistence)
# Production target: PostgreSQL
# Local optional: SQLite
DATABASE_URL=sqlite:///./runtime_data/alpilab_ai.dev.db

# --- Secrets (NEVER commit real values) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
