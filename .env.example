# Alpilab AI environment template
# Copy to `.env` and fill values locally. Never commit real secrets.

APP_NAME=Alpilab AI
APP_ENV=development
DEBUG=true

# Only "mock" is implemented in this foundation phase.
AI_PROVIDER=mock

# Placeholder DB URL — no ORM wired yet.
# Production target: PostgreSQL. Local optional: SQLite.
DATABASE_URL=sqlite:///./runtime_data/alpilab_ai.db

STORAGE_ROOT=./runtime_data/storage

# Future provider keys (leave empty — do not put real keys in git):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
