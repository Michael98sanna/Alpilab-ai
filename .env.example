# Alpilab AI — environment template
# Copy to .env and fill values. NEVER commit real secrets.

APP_NAME=Alpilab AI
ENVIRONMENT=development

# Foundation phase: only "mock" is supported.
AI_PROVIDER=mock

# Optional future database (PostgreSQL in production, SQLite for local).
# DATABASE_URL=postgresql://user:password@localhost:5432/alpilab_ai
# DATABASE_URL=sqlite:///./runtime_data/alpilab_ai.db

API_HOST=127.0.0.1
API_PORT=8000

# Future AI provider keys — leave empty until real integrations exist.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
