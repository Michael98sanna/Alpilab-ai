# Copy this file to .env and fill in local values.
# Never commit .env or real secrets.

# --- Application ---
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# --- AI ---
# Logical provider name. Only "mock" is implemented in this phase.
AI_PROVIDER=mock

# Future cloud/local providers will read keys from the environment.
# Leave these empty until a real provider is implemented.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
